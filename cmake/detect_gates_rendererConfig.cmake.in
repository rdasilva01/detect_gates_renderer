@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(OpenCV REQUIRED COMPONENTS core imgproc calib3d imgcodecs)
find_dependency(Eigen3 REQUIRED)
find_dependency(yaml-cpp REQUIRED)
# Only when this build actually found it: the static library records OpenMP in its
# export set even though it links it PRIVATE, so consumers must be able to resolve
# the imported target -- but a build without OpenMP never references it.
if(@OpenMP_CXX_FOUND@)
    find_dependency(OpenMP COMPONENTS CXX)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/detect_gates_rendererTargets.cmake")
